//@version=6
// =============================================================================
// AMT Volumetric Auction — STRATEGY version (for backtesting)
// -----------------------------------------------------------------------------
// Identical signal engine to the "AMT Volumetric Auction (Minimalist)"
// indicator, wrapped in strategy() so every setup can be measured with real
// numbers (equity curve, win rate, profit factor) instead of eyeballing
// arrows. Orders fill on the close of the signal bar
// (process_orders_on_close = true) to match the indicator's semantics.
// =============================================================================
strategy(title = "AMT Volumetric Auction (Strategy)", shorttitle = "AMT-STRAT", overlay = true, initial_capital = 25000, default_qty_type = strategy.percent_of_equity, default_qty_value = 10, commission_type = strategy.commission.percent, commission_value = 0.02, slippage = 1, process_orders_on_close = true, max_bars_back = 1000)

// =============================================================================
// [INPUT PARAMETERS]
// =============================================================================
string G1 = "Session & Profile"
string G2 = "Order Flow"
string G3 = "Strategy Menu"
string G4 = "Risk & Exits"

sessionSpec  = input.session("0930-1600", title = "Session Hours (New York)", group = G1)
sessionTz    = input.string("America/New_York", title = "Session Timezone", group = G1)
vaPercentInp = input.int(70, title = "Value Area Percentage", minval = 10, maxval = 95, step = 1, group = G1)
profileRows  = input.int(50, title = "Profile Resolution (rows)", minval = 10, maxval = 200, group = G1)
warmupBars   = input.int(6,  title = "Warmup Bars (use prior-day levels before)", minval = 0, group = G1)

useIntrabar    = input.bool(true, title = "Use Intrabar (LTF) Data", group = G2)
ltfTf          = input.timeframe("1", title = "Intrabar Timeframe", group = G2)
volMaPeriod    = input.int(20, title = "Volume MA Period", minval = 1, group = G2)
volSpikeMult   = input.float(1.5, title = "Volume Spike Multiplier", minval = 1.0, step = 0.1, group = G2)
tightRangeMult = input.float(0.8, title = "Tight Range Multiplier", minval = 0.1, maxval = 1.0, step = 0.05, group = G2)

useTrend   = input.bool(true, title = "Setup 1: Trend Continuation outside Balance", group = G3)
useMeanRev = input.bool(true, title = "Setup 2: Mean Reversion at Value Area Edges", group = G3)
useTrapped = input.bool(true, title = "Setup 3: Trapped Traders / Absorption",       group = G3)
useRegime  = input.bool(true, title = "Regime Filter (mute Mean Reversion on trend days)", group = G3)
regimeBars = input.int(3, title = "Bars outside prior VA to call a Trend Day", minval = 1, group = G3)

stopAtrMult   = input.float(2.0, title = "ATR Stop Multiplier (0 = off)", minval = 0.0, step = 0.25, group = G4)
atrLen        = input.int(14, title = "ATR Length", minval = 1, group = G4)
deltaExitBars = input.int(2, title = "Opposing Delta Bars to Exit", minval = 1, group = G4)
timeStopBars  = input.int(0, title = "Time Stop in Bars (0 = off)", minval = 0, group = G4)
exitEOS       = input.bool(true, title = "Force Flat at End of Session", group = G4)

// =============================================================================
// SESSION DETECTION
// =============================================================================
inSession  = not na(time(timeframe.period, sessionSpec, sessionTz))
newSession = inSession and not inSession[1]
sessionEnd = not inSession and inSession[1]

// =============================================================================
// ORDER FLOW — INTRABAR DATA + DELTA / CVD
// =============================================================================
float vol = nz(volume)
priceRange = high - low

bool ltfOk = timeframe.in_seconds(ltfTf) < timeframe.in_seconds(timeframe.period)
[ltfO, ltfH, ltfL, ltfC, ltfV] = request.security_lower_tf(syminfo.tickerid, ltfOk ? ltfTf : timeframe.period, [open, high, low, close, volume])
int nLtf = array.size(ltfC)
bool intrabarLive = useIntrabar and ltfOk and nLtf > 0

float proxyDelta = priceRange > 0 ? vol * (close - open) / priceRange : 0.0
float ltfDelta = 0.0
if intrabarLive
    for i = 0 to nLtf - 1
        float bodyDir = array.get(ltfC, i) - array.get(ltfO, i)
        float v = nz(array.get(ltfV, i))
        ltfDelta += bodyDir > 0 ? v : bodyDir < 0 ? -v : 0.0
delta = intrabarLive ? ltfDelta : proxyDelta

var float cvd = 0.0
cvd := newSession ? delta : cvd + delta

volMa    = ta.sma(vol, volMaPeriod)
avgRange = ta.sma(priceRange, volMaPeriod)
atrVal   = ta.atr(atrLen)
highVol     = vol > volMa * volSpikeMult
tightSpread = priceRange < avgRange * tightRangeMult
absorption  = highVol and tightSpread

// =============================================================================
// [CORE] SESSION VOLUME PROFILE via DYNAMIC ARRAYS
// =============================================================================
var array<float> obsHigh = array.new_float(0)
var array<float> obsLow  = array.new_float(0)
var array<float> obsVol  = array.new_float(0)

var float sessHigh  = na
var float sessLow   = na
var float cvdAtHigh = na
var float cvdAtLow  = na

var float poc  = na
var float vah  = na
var float val  = na
var float pPoc = na
var float pVah = na
var float pVal = na

var array<float> bins = array.new_float(0)
var float gridLow   = na
var float gridBin   = na
var int   binnedObs = 0

if newSession
    pPoc := poc
    pVah := vah
    pVal := val
    array.clear(obsHigh)
    array.clear(obsLow)
    array.clear(obsVol)
    array.clear(bins)
    gridLow := na
    gridBin := na
    binnedObs := 0
    sessHigh := high
    sessLow  := low
    cvdAtHigh := cvd
    cvdAtLow  := cvd
    poc := na
    vah := na
    val := na
else if inSession
    if high > sessHigh
        sessHigh := high
        cvdAtHigh := cvd
    if low < sessLow
        sessLow := low
        cvdAtLow := cvd

if inSession
    if intrabarLive
        for i = 0 to nLtf - 1
            array.push(obsHigh, array.get(ltfH, i))
            array.push(obsLow,  array.get(ltfL, i))
            array.push(obsVol,  nz(array.get(ltfV, i)))
    else
        array.push(obsHigh, high)
        array.push(obsLow, low)
        array.push(obsVol, vol)

if inSession and array.size(obsVol) > 0 and not na(sessHigh) and not na(sessLow) and sessHigh > sessLow
    int rows = profileRows
    float gridTop = na(gridLow) or na(gridBin) ? na : gridLow + gridBin * rows
    bool rebuild = na(gridLow) or na(gridBin) or sessLow < gridLow or sessHigh > gridTop
    if rebuild
        float rng = sessHigh - sessLow
        gridLow := sessLow - rng * 0.10
        gridBin := rng * 1.20 / rows
        array.clear(bins)
        for i = 0 to rows - 1
            array.push(bins, 0.0)
        binnedObs := 0

    int nObs = array.size(obsVol)
    if binnedObs < nObs and gridBin > 0
        for i = binnedObs to nObs - 1
            float oh    = array.get(obsHigh, i)
            float ol    = array.get(obsLow, i)
            int   loIdx = int(math.floor((ol - gridLow) / gridBin))
            int   hiIdx = int(math.floor((oh - gridLow) / gridBin))
            loIdx := math.max(0, math.min(rows - 1, loIdx))
            hiIdx := math.max(0, math.min(rows - 1, hiIdx))
            int   span   = hiIdx - loIdx + 1
            float perBin = array.get(obsVol, i) / span
            for j = loIdx to hiIdx
                array.set(bins, j, array.get(bins, j) + perBin)
        binnedObs := nObs

    if array.size(bins) == rows
        int   pocIdx = 0
        float pocVol = 0.0
        float total  = 0.0
        for i = 0 to rows - 1
            float v = array.get(bins, i)
            total += v
            if v > pocVol
                pocVol := v
                pocIdx := i

        if total > 0
            poc := gridLow + gridBin * (pocIdx + 0.5)

            float vaTarget = total * vaPercentInp / 100.0
            float accVol   = pocVol
            int   upIdx    = pocIdx
            int   dnIdx    = pocIdx
            int   lastIdx  = rows - 1
            for _i = 0 to lastIdx
                if accVol >= vaTarget
                    break
                float upVol = upIdx < lastIdx ? array.get(bins, upIdx + 1) : -1.0
                float dnVol = dnIdx > 0       ? array.get(bins, dnIdx - 1) : -1.0
                if upVol < 0 and dnVol < 0
                    break
                if upVol >= dnVol
                    upIdx += 1
                    accVol += upVol
                else
                    dnIdx -= 1
                    accVol += dnVol
            vah := gridLow + gridBin * (upIdx + 1)
            val := gridLow + gridBin * dnIdx

// =============================================================================
// EFFECTIVE LEVELS (early-session warmup) + REGIME FILTER
// =============================================================================
var int sessBars = 0
sessBars := newSession ? 1 : inSession ? sessBars + 1 : sessBars

bool priorReady = not na(pPoc) and not na(pVah) and not na(pVal)
bool warmup     = sessBars < warmupBars and priorReady
float effPoc = warmup ? pPoc : poc
float effVah = warmup ? pVah : vah
float effVal = warmup ? pVal : val
profileReady = not na(effPoc) and not na(effVah) and not na(effVal)

var int outsideVaCount = 0
if newSession
    outsideVaCount := 0
if inSession and priorReady
    outsideVaCount := close > pVah or close < pVal ? outsideVaCount + 1 : 0
bool trendDay = outsideVaCount >= regimeBars

// =============================================================================
// [TRADING SETUPS]
// =============================================================================
volRising = vol > vol[1] and vol > volMa
deltaBull = delta > 0
deltaBear = delta < 0

var bool brokeAboveVAH = false
var bool brokeBelowVAL = false
var int  breakUpBar    = na
var int  breakDnBar    = na
if newSession
    brokeAboveVAH := false
    brokeBelowVAL := false
    breakUpBar := na
    breakDnBar := na
if profileReady and inSession
    if close > effVah and volRising and deltaBull
        if not brokeAboveVAH
            breakUpBar := bar_index
        brokeAboveVAH := true
    if close < effVal and volRising and deltaBear
        if not brokeBelowVAL
            breakDnBar := bar_index
        brokeBelowVAL := true
    if close < effPoc
        brokeAboveVAH := false
        breakUpBar := na
    if close > effPoc
        brokeBelowVAL := false
        breakDnBar := na

trendLong  = useTrend and profileReady and brokeAboveVAH and not na(breakUpBar) and bar_index > breakUpBar and low  <= effVah and close > effVah and deltaBull
trendShort = useTrend and profileReady and brokeBelowVAL and not na(breakDnBar) and bar_index > breakDnBar and high >= effVal and close < effVal and deltaBear

inBalance     = profileReady and close <= effVah and close >= effVal
touchedVAH    = profileReady and high >= effVah
touchedVAL    = profileReady and low  <= effVal
deltaFlipDown = delta < 0 and delta[1] >= 0
deltaFlipUp   = delta > 0 and delta[1] <= 0
regimeAllowsMR = not useRegime or not trendDay

meanRevShort = useMeanRev and regimeAllowsMR and inBalance and touchedVAH and close < effVah and deltaFlipDown
meanRevLong  = useMeanRev and regimeAllowsMR and inBalance and touchedVAL and close > effVal and deltaFlipUp

failedHigh = inSession and not newSession and not na(sessHigh[1]) and high >= sessHigh[1] and close < sessHigh[1]
failedLow  = inSession and not newSession and not na(sessLow[1])  and low  <= sessLow[1]  and close > sessLow[1]
cvdDivBear = not na(cvdAtHigh[1]) and cvd < cvdAtHigh[1]
cvdDivBull = not na(cvdAtLow[1])  and cvd > cvdAtLow[1]

trappedShort = useTrapped and failedHigh and (highVol or absorption) and cvdDivBear
trappedLong  = useTrapped and failedLow  and (highVol or absorption) and cvdDivBull

rawLong  = (trendLong  or meanRevLong  or trappedLong)  and inSession
rawShort = (trendShort or meanRevShort or trappedShort) and inSession

// =============================================================================
// [ORDER MANAGEMENT] — mirrors the indicator's state machine using the
// strategy engine's real position (fills, sizing, commission included).
// =============================================================================
int position = strategy.position_size > 0 ? 1 : strategy.position_size < 0 ? -1 : 0
bool justEntered = position != 0 and position[1] == 0

var float stopLevel   = na
var int   barsInTrade = 0
barsInTrade := position == 0 ? 0 : justEntered ? 0 : barsInTrade + 1

var int deltaAgainstLong  = 0
var int deltaAgainstShort = 0
deltaAgainstLong  := delta < 0 ? deltaAgainstLong  + 1 : 0
deltaAgainstShort := delta > 0 ? deltaAgainstShort + 1 : 0
if justEntered
    stopLevel := stopAtrMult > 0 ? (position == 1 ? strategy.position_avg_price - stopAtrMult * atrVal : strategy.position_avg_price + stopAtrMult * atrVal) : na
    if position == 1
        deltaAgainstLong := 0
    else
        deltaAgainstShort := 0

float entryPrice = position != 0 ? strategy.position_avg_price : na

longTargetHit  = profileReady and not na(entryPrice) and ((effPoc > entryPrice and high >= effPoc) or (effVah > entryPrice and high >= effVah))
shortTargetHit = profileReady and not na(entryPrice) and ((effPoc < entryPrice and low  <= effPoc) or (effVal < entryPrice and low  <= effVal))

stopHitLong  = not na(stopLevel) and low  <= stopLevel
stopHitShort = not na(stopLevel) and high >= stopLevel
timeStopHit  = timeStopBars > 0 and barsInTrade >= timeStopBars
eosFlat      = exitEOS and sessionEnd

longExit  = position == 1  and (longTargetHit  or deltaAgainstLong  >= deltaExitBars or stopHitLong  or timeStopHit or eosFlat)
shortExit = position == -1 and (shortTargetHit or deltaAgainstShort >= deltaExitBars or stopHitShort or timeStopHit or eosFlat)

if longExit
    strategy.close("Long", comment = "Exit L")
    stopLevel := na
if shortExit
    strategy.close("Short", comment = "Exit S")
    stopLevel := na

bool canEnter = position == 0 and not longExit and not shortExit
if rawLong and canEnter
    strategy.entry("Long", strategy.long)
else if rawShort and canEnter
    strategy.entry("Short", strategy.short)
