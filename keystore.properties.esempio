# Copy this file to `keystore.properties` and fill it in. That copy is in .gitignore and
# must stay there: it holds the passwords of the key that signs the app.
#
# To create a key (once, and then never again — the same key has to sign every future update):
#
#   keytool -genkeypair -v \
#       -keystore ~/cybersensei-release.jks \
#       -alias cybersensei -keyalg RSA -keysize 4096 -validity 10000
#
# Keep the .jks file outside the repository and back it up somewhere you will still have in
# five years. Lose it and this app can never be updated again — a new key means a different
# app as far as Android is concerned. Leak it and someone else's build can install over yours
# as though you had written it.
#
# A build machine can pass the same four values as environment variables instead of a file:
# CYBERSENSEI_STORE_FILE, CYBERSENSEI_STORE_PASSWORD, CYBERSENSEI_KEY_ALIAS,
# CYBERSENSEI_KEY_PASSWORD. With neither, the release is signed with the debug key and Gradle
# says so out loud.

storeFile=/percorso/assoluto/cybersensei-release.jks
storePassword=
keyAlias=cybersensei
keyPassword=
