<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Deliberately empty permission list.

        Cyber Sensei teaches that an app should ask for the least it needs, so it asks for
        nothing: no INTERNET, no storage, no location. Everything the school knows lives in
        this device and cannot leave it. Module 3.6 asks the student to verify this file.
        POST_NOTIFICATIONS will be added in Fase 3, when the professor starts scheduling
        the spaced-repetition reminders.
    -->

    <application
        android:name=".CyberSenseiApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CyberSensei.Starting">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CyberSensei.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
