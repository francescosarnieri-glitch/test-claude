# ---------------------------------------------------------------------------
# memescan - configurazione
# Copia questo file in `.env` e riempi i valori. Nessuna chiave privata, mai.
# ---------------------------------------------------------------------------

# --- Telegram (obbligatorio per gli alert) ---------------------------------
# 1. Apri @BotFather su Telegram -> /newbot -> copia il token
# 2. Apri @userinfobot -> copia il tuo "Id"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- RPC Robinhood Chain (chain id 4663) -----------------------------------
# Il default pubblico funziona ma ha rate limit bassi: per il polling continuo
# metti una key Alchemy o QuickNode (entrambi hanno un tier gratuito).
#   Alchemy:   https://robinhood-mainnet.g.alchemy.com/v2/LA_TUA_KEY
RPC_URL=https://rpc.mainnet.chain.robinhood.com
RPC_URL_FALLBACK=
CHAIN_ID=4663

# Explorer Blockscout: usato per holder, token transfer e verifica contratti.
BLOCKSCOUT_URL=https://robinhoodchain.blockscout.com
# Alcune istanze Blockscout richiedono una key per i rate limit alti (opzionale)
BLOCKSCOUT_API_KEY=

# --- Slug delle piattaforme dati -------------------------------------------
DEXSCREENER_CHAIN=robinhood
# Slug GeckoTerminal: lascialo vuoto e verra' rilevato in automatico al primo avvio
GECKOTERMINAL_NETWORK=

# --- Filtri dello scanner ---------------------------------------------------
# Un pair deve superare TUTTI questi minimi per essere anche solo considerato.
MIN_LIQUIDITY_USD=8000
MAX_LIQUIDITY_USD=2000000
MIN_VOLUME_5M_USD=3000
MIN_VOLUME_1H_USD=15000
MIN_TXNS_5M=25
MIN_HOLDERS=60
MIN_AGE_MINUTES=20
MAX_AGE_HOURS=72
# Rapporto volume/liquidita': troppo alto = probabile wash trading
MAX_VOL_LIQ_RATIO=40
# Percentuale massima detenuta dai primi 10 holder (esclusi LP e burn address)
MAX_TOP10_HOLDER_PCT=35
# Percentuale massima detenuta dal deployer
MAX_DEPLOYER_PCT=5

# --- Soglie di alert --------------------------------------------------------
# Punteggio minimo (0-100) per far scattare la notifica Telegram
ALERT_MIN_SCORE=70
# Non rimandare un alert sullo stesso token prima di N minuti
ALERT_COOLDOWN_MINUTES=180
# Manda un alert anche se il punteggio e' sotto soglia quando N wallet
# tracciati comprano lo stesso token
WALLET_CONVERGENCE_THRESHOLD=2

# --- Wallet tracker ---------------------------------------------------------
# Indirizzi EVM separati da virgola. Puoi lasciarlo vuoto e popolarlo dopo con:
#   python -m memescan.cli discover-wallets --days 7 --top 30
TRACKED_WALLETS=
WALLET_POLL_SECONDS=45

# --- Intervalli di polling (secondi) ---------------------------------------
SCAN_INTERVAL_SECONDS=20
ENRICH_INTERVAL_SECONDS=60
# Quanti blocchi indietro leggere al primo avvio per i nuovi pool.
# Robinhood Chain fa un blocco ogni ~0,1s: 20000 blocchi = circa mezz'ora.
ONCHAIN_BACKFILL_BLOCKS=20000

# --- Social (opzionale) -----------------------------------------------------
# Senza un piano X a pagamento questo modulo resta spento e non e' un problema:
# il segnale on-chain arriva comunque prima.
X_BEARER_TOKEN=
LUNARCRUSH_API_KEY=

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
# Token per proteggere la dashboard quando la esponi fuori da casa.
# Se vuoto, l'API e' aperta: NON lasciarlo vuoto su un VPS pubblico.
API_TOKEN=
DB_PATH=data/memescan.db
LOG_LEVEL=INFO
